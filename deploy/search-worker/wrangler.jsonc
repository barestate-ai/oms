{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "oms-search-api",
  "account_id": "476f3d30838d09d1253b76f0c92c265d",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "barestate.xyz/oms-search-api/*", "zone_name": "barestate.xyz" },
    { "pattern": "barestate.xyz/oms/search/*", "zone_name": "barestate.xyz" },
  ],
  "services": [
    { "binding": "GATEWAY", "service": "oms" },
    { "binding": "BILLING", "service": "oms", "entrypoint": "SearchBilling" },
  ],
  "kv_namespaces": [{ "binding": "CACHE", "id": "bf589116b2d54d8aaf83e0c0939e62b4" }],
  "durable_objects": { "bindings": [{ "name": "GATE", "class_name": "ContextDevGate" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["ContextDevGate"] }],
  "analytics_engine_datasets": [{ "binding": "USAGE_EVENTS", "dataset": "oms_search_usage" }],
  "vars": { "CONTEXT_DEV_ZDR": "disabled" },
  "observability": { "enabled": true, "head_sampling_rate": 1, "logs": { "invocation_logs": false } },
}
