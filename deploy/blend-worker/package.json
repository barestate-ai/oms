{
  "name": "oms-blend-worker",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node src/node-server.ts",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.jsonc\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\" \"*.json\" \"*.jsonc\"",
    "kill": "wrangler kv key put blend:disabled 1 --binding CACHE --remote",
    "unkill": "wrangler kv key delete blend:disabled --binding CACHE --remote",
    "put-secrets": "bash scripts/put-secrets.sh"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261102.1",
    "@types/node": "^22.10.0",
    "prettier": "3.10.1",
    "typescript": "^5.9.3",
    "wrangler": "4.156.2"
  }
}
